# Public origin used for canonical links, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://ctokoffi.me
# Optional: your exported Spline .splinecode scene. Native Three.js is the default.
NEXT_PUBLIC_SPLINE_SCENE_URL=

# Firebase Console → Project settings → Your apps → Web app → Config.
# Enable Google Analytics for this Firebase project and use the same web data stream.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=
